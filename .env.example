# OpenMedic environment variables — EXAMPLE ONLY.
#
# Copy to `.env` and fill in values locally. NEVER commit a filled `.env`.
# `.gitignore` excludes `.env` but keeps this example.
#
# Every variable below is OPTIONAL. OpenMedic runs fully offline with none of them set.

# --- Logging ---------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
OPENMEDIC_LOG_LEVEL=WARNING

# --- Local incident database ------------------------------------------------
# Path to the SQLite incident store. Must be inside a gitignored directory.
OPENMEDIC_DB=data/openmedic.db

# --- Model provider (optional enrichment) ---------------------------------
# The provider is optional. With no provider configured, deterministic diagnosis
# still works and produces identical results.
#
# OPENMEDIC_PROVIDER_TYPE=openai-compatible
#
# IMPORTANT: `OPENMEDIC_PROVIDER_API_KEY_ENV` holds the NAME of the environment
# variable that holds the key, never the key itself. Set the key only in your shell
# or a local secret store, never in this file.
#
# OPENMEDIC_PROVIDER_API_KEY_ENV=OPENMEDIC_PROVIDER_API_KEY
#
# OPENMEDIC_PROVIDER_ENDPOINT=https://api.example.com/v1
# OPENMEDIC_PROVIDER_MODEL=gpt-4o-mini
# OPENMEDIC_PROVIDER_TIMEOUT=30

# --- GitHub integration (optional) -----------------------------------------
# Read-only scopes (e.g. actions:read, repo:status) are sufficient for diagnosis.
# Write operations (comments, branches, PRs) need separate, explicit permissions and
# are opt-in per command.
#
# OPENMEDIC_GITHUB_TOKEN=
